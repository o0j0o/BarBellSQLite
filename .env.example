# LT_DSN is the fallback Windows ODBC DSN name, used only if settings.json's
# "Label Traxx Plant" (setup_gui.py) is left unset. Once Setup has been saved
# at least once, its choice takes over - see src/settings.py.
LT_DSN=LT64
LT_USER=designer
LT_PASSWORD=

# LT_HOST/LT_PORT are not read by the app - the actual server address for a
# DSN (e.g. LT64 or "LCJ JAM") lives entirely in Windows' own ODBC Data
# Source Administrator on this machine, not here. Left here only as a record
# of which DSN points where:
#   LT64      -> 10.2.1.6:19812      (Barbados)
#   LCJ JAM   -> 192.168.246.6:19812 (Jamaica)

# GS1 Company Prefix, SSCC extension digit, counter file, CSV output
# directory, and Label Traxx Plant now live in settings.json - run
# setup_gui.py to configure them.
